{
  "name": "jyz-local",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "JYZ_WORKER_LOCAL": "true",
    "JYZ_REVIEW_ORIGIN": "http://127.0.0.1:8787",
    "JYZ_DB_SCHEMA": "jyz_worker_local"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "assets": {
    "directory": "assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "python_modules": {
    "exclude": [
      "**/*.pyc",
      "**/__pycache__/**",
      ".venv-workers/**",
      "node_modules/**",
      ".wrangler/**",
      "**/tests_runtime.py",
      "catalogo/tests.py"
    ]
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ]
}
